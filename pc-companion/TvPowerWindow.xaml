<Window x:Class="PcCompanion.TvPowerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TV power" Height="420" Width="360"
        Background="#122321"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="TvPowerActionButton" TargetType="Button">
            <Setter Property="Background" Value="#16302C"/>
            <Setter Property="Foreground" Value="#EEF7F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22403B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="#122321" BorderBrush="#22403B" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="TV power" FontSize="16" FontWeight="Bold" Foreground="#EEF7F4" Margin="0,0,0,4"/>
            <TextBlock x:Name="StatusText" Grid.Row="1" Text="Wake, power off, and restart all use the same one-time pairing below."
                       FontSize="11" Foreground="#8FB3AC" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel x:Name="ActionsPanel" Grid.Row="2" Visibility="Visible">
                <Button Content="⏻  Wake TV" Click="OnWakeClick" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TvPowerActionButton}"/>
                    </Button.Style>
                </Button>
                <Button Content="⭘  Power off TV" Click="OnPowerOffClick" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TvPowerActionButton}"/>
                    </Button.Style>
                </Button>
                <Button Content="↻  Restart TV" Click="OnRestartClick" Margin="0,0,0,8" HorizontalContentAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TvPowerActionButton}"/>
                    </Button.Style>
                </Button>
                <Button Content="⚙  Pair (required once)" Click="OnPairClick" HorizontalContentAlignment="Left">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource TvPowerActionButton}"/>
                    </Button.Style>
                </Button>
            </StackPanel>

            <StackPanel x:Name="PinPanel" Grid.Row="2" Visibility="Collapsed">
                <TextBlock Text="Make sure the TV is on and its screen is visible, then press Start. A PIN will appear on the TV."
                           FontSize="11" Foreground="#8FB3AC" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TextBlock x:Name="PinLabel" Text="PIN" FontSize="11" Foreground="#8FB3AC" Margin="0,0,0,4" Visibility="Collapsed"/>
                <TextBox x:Name="PinBox" Background="#16302C" Foreground="#EEF7F4" BorderBrush="#22403B"
                         BorderThickness="1" Padding="10,7" CaretBrush="#37C6B0" Margin="0,0,0,12" Visibility="Collapsed"/>
                <TextBlock x:Name="PinErrorText" Foreground="#FF6B5E" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
                <Button x:Name="PinActionButton" Content="Start" Click="OnPinActionClick" IsDefault="True" HorizontalAlignment="Right">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#37C6B0"/>
                            <Setter Property="Foreground" Value="#0B1615"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Row="3" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,20,0,0" Click="OnCloseClick">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#16302C"/>
                        <Setter Property="Foreground" Value="#EEF7F4"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#22403B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</Window>
