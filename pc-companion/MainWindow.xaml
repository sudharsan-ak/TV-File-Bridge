<Window x:Class="PcCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PcCompanion"
        Title="TV File Bridge - Clipboard" Height="680" Width="820" MinWidth="640" MinHeight="480"
        Background="#0B1615"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:ClipboardItemTypeToVisibilityConverter x:Key="TextVisibility" ShowFor="Text"/>
        <local:ClipboardItemTypeToVisibilityConverter x:Key="ImageVisibility" ShowFor="Image"/>
        <local:ClipboardItemTypeToVisibilityConverter x:Key="FileVisibility" ShowFor="File"/>
        <local:ImagePathToBitmapConverter x:Key="ImagePathToBitmap"/>
        <local:BoolToVisibilityConverter x:Key="BoolVisibility"/>
        <local:BoolToSelectedCircleBackgroundConverter x:Key="SelectedCircleBackground"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolVisibility"/>
        <local:PrimaryButtonLabelConverter x:Key="PrimaryButtonLabel"/>
        <local:TransferStatusToVisibilityConverter x:Key="TransferInProgressVisibility" ShowFor="InProgress"/>
        <local:TransferStatusToVisibilityConverter x:Key="TransferFailedVisibility" ShowFor="Failed"/>
        <local:TransferStatusToVisibilityConverter x:Key="TransferSucceededVisibility" ShowFor="Succeeded"/>
        <local:DirectionLabelConverter x:Key="DirectionLabel"/>

        <SolidColorBrush x:Key="SurfaceBrush" Color="#122321"/>
        <SolidColorBrush x:Key="CardBrush" Color="#16302C"/>
        <SolidColorBrush x:Key="TealBrush" Color="#37C6B0"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#F0A94E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#EEF7F4"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8FB3AC"/>
        <SolidColorBrush x:Key="HairlineBrush" Color="#22403B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource TealBrush}"/>
            <Setter Property="Foreground" Value="#0B1615"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Round icon button matching the phone app's RemoteIconButton -
             fixed circular size (Width = Height), same CardBrush fill, no
             border, used for every Remote-tab control (D-pad arrows, OK,
             Home/Power/Settings/Input, volume, media transport). -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="999">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CircleAccentButton" TargetType="Button" BasedOn="{StaticResource CircleButton}">
            <Setter Property="Background" Value="{StaticResource TealBrush}"/>
            <Setter Property="Foreground" Value="#0B1615"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CaretBrush" Value="{StaticResource TealBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#0B1615"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="Transparent" CornerRadius="999" Padding="16,8" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Name="Border" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Home screen's clickable nav-shortcut cards - same shape as
             CardBorder plus a hover highlight + slight scale-up, so hovering
             signals "this is clickable" the way the plain CardBorder (used
             for non-clickable cards elsewhere, e.g. Transfers/History) never
             needed to. RenderTransformOrigin centers the scale so it grows
             evenly instead of shifting toward one corner. -->
        <Style x:Key="HomeNavCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HairlineBrush}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Shared by both Sent and Received sub-tabs under Transfers - same
             card shape either way, "with {OtherDeviceName}" reads correctly
             regardless of direction so no separate templates are needed. -->
        <DataTemplate x:Key="TransferCardTemplate">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    </Grid>
                    <TextBlock Text="{Binding OtherDeviceName, StringFormat='with {0}'}"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,8"/>
                    <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                 Visibility="{Binding Status, Converter={StaticResource TransferInProgressVisibility}}"
                                 Foreground="{StaticResource TealBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF6B5E" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Status, Converter={StaticResource TransferFailedVisibility}}"/>
                    <Button Content="Cancel" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Margin="0,8,0,0"
                            Click="OnCancelTransferClick" Tag="{Binding}"
                            Visibility="{Binding Status, Converter={StaticResource TransferInProgressVisibility}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Visibility="{Binding Status, Converter={StaticResource TransferSucceededVisibility}}">
                        <Button Content="Open" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                Click="OnOpenTransferFileClick" Tag="{Binding}"/>
                        <Button Content="Show in folder" Style="{StaticResource FlatButton}"
                                Click="OnShowTransferFileInFolderClick" Tag="{Binding}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="NavPanel" Grid.Column="0" Margin="0,8,12,0" Visibility="Collapsed">
            <RadioButton x:Name="NavHome" Content="Home" Style="{StaticResource NavItem}" IsChecked="True" GroupName="Nav" Margin="0,0,0,4"/>
            <RadioButton x:Name="NavDevices" Content="Devices" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4"/>
            <RadioButton x:Name="NavTransfers" Content="Transfers" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4"/>
            <RadioButton x:Name="NavTvFiles" Content="TV Files" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4" Checked="OnNavTvFilesChecked"/>
            <RadioButton x:Name="NavInstallApk" Content="Install APK" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4"/>
            <RadioButton x:Name="NavScreenView" Content="Screen View" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4" Checked="OnNavScreenViewChecked"/>
            <RadioButton x:Name="NavRemote" Content="Remote" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4" Checked="OnNavRemoteChecked" Unchecked="OnNavRemoteUnchecked"/>
            <RadioButton x:Name="NavHistory" Content="History" Style="{StaticResource NavItem}" GroupName="Nav" Margin="0,0,0,4"/>
            <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavItem}" GroupName="Nav"/>
        </StackPanel>

        <Border x:Name="NavDivider" Grid.Column="0" Background="{StaticResource HairlineBrush}" Width="1" HorizontalAlignment="Right" Margin="0,8,0,8" Visibility="Collapsed"/>

        <DockPanel Grid.Column="1" Margin="16,0,0,0" PreviewMouseDown="OnContentAreaPreviewMouseDown">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="NavToggleButton" Content="☰" Style="{StaticResource FlatButton}"
                    Padding="10,6" Click="OnNavToggleClick" ToolTip="Show/hide navigation"/>
            <Button Content="🏠" Style="{StaticResource FlatButton}" Padding="10,6" Margin="6,0,0,0"
                    Click="OnHomeButtonClick" ToolTip="Home"/>
        </StackPanel>
        <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Visibility="{Binding IsChecked, ElementName=NavHome, Converter={StaticResource BoolVisibility}}">
        <StackPanel Margin="0,16,0,0">
            <TextBlock Text="TV File Bridge" FontSize="22" FontWeight="Bold"/>
            <TextBlock Text="Clipboard and file sync between this PC and your phone/TV setup." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,20"/>
            <!-- WrapPanel, not a fixed StackPanel - cards wrap onto as many
                 columns as the window is wide enough for (2-3 on a wide
                 window, 1 on a narrow one), adjusting live as the window is
                 resized with no extra layout logic needed. -->
            <WrapPanel Orientation="Horizontal">
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavDevices}">
                    <StackPanel>
                        <TextBlock Text="Devices" FontWeight="Bold"/>
                        <TextBlock Text="Phones paired with this PC for clipboard and file sync." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavTransfers}">
                    <StackPanel>
                        <TextBlock Text="Transfers" FontWeight="Bold"/>
                        <TextBlock Text="Files sent and received between this PC and your phone." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavTvFiles}">
                    <StackPanel>
                        <TextBlock Text="TV Files" FontWeight="Bold"/>
                        <TextBlock Text="Browse and download files straight from your TV over ADB." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavScreenView}">
                    <StackPanel>
                        <TextBlock Text="Screen View" FontWeight="Bold"/>
                        <TextBlock Text="Mirror a TV's screen on this PC." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavRemote}">
                    <StackPanel>
                        <TextBlock Text="Remote" FontWeight="Bold"/>
                        <TextBlock Text="D-pad, volume, power, and app launcher for the connected TV." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavHistory}">
                    <StackPanel>
                        <TextBlock Text="History" FontWeight="Bold"/>
                        <TextBlock Text="Everything copied or sent between this PC and your devices." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource HomeNavCard}" Width="240" Cursor="Hand" MouseLeftButtonUp="OnHomeCardClick" Tag="{Binding ElementName=NavSettings}">
                    <StackPanel>
                        <TextBlock Text="Settings" FontWeight="Bold"/>
                        <TextBlock Text="Device name, port, startup behavior, and auto-send rules." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
        </ScrollViewer>
        <DockPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavHistory, Converter={StaticResource BoolVisibility}}">
                <Button DockPanel.Dock="Top" Content="Clear all" Style="{StaticResource FlatButton}"
                        HorizontalAlignment="Right" Margin="0,0,0,12" Click="OnClearAllClick"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HistoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Text}"
                                                       Visibility="{Binding Type, Converter={StaticResource TextVisibility}}"
                                                       TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                            <Border Visibility="{Binding Type, Converter={StaticResource ImageVisibility}}"
                                                    CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left"
                                                    Cursor="Hand" MouseLeftButtonUp="OnHistoryImageClick" Tag="{Binding}">
                                                <Image Source="{Binding ImageFilePath, Converter={StaticResource ImagePathToBitmap}}"
                                                       Height="64"/>
                                            </Border>
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold"
                                                       Visibility="{Binding Type, Converter={StaticResource FileVisibility}}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,6,0,0">
                                                <Run Text="{Binding Direction, Converter={StaticResource DirectionLabel}, Mode=OneWay}"/>
                                                <Run Text="{Binding SourceDeviceName, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Content="Open" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                    Click="OnOpenFileClick" Tag="{Binding}"
                                                    Visibility="{Binding Type, Converter={StaticResource FileVisibility}}"/>
                                            <Button Content="Show in folder" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                    Click="OnShowInFolderClick" Tag="{Binding}"
                                                    Visibility="{Binding Type, Converter={StaticResource FileVisibility}}"/>
                                            <Button Content="Copy" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                    Click="OnRecopyClick" Tag="{Binding}"/>
                                            <Button Content="Delete" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                                                    Click="OnDeleteItemClick" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

        <DockPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavDevices, Converter={StaticResource BoolVisibility}}">
                <TextBlock DockPanel.Dock="Top" Text="Paired phones" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding PairedDevices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                                <TextBlock Text="PRIMARY" FontSize="10" FontWeight="Bold" Margin="6,2,0,0"
                                                           Foreground="{StaticResource TealBrush}"
                                                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding IpAddress}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="{Binding IsPrimary, Converter={StaticResource PrimaryButtonLabel}}"
                                                    Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                    Click="OnTogglePrimaryClick" Tag="{Binding}"/>
                                            <Button Content="Reconnect" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                    Click="OnReconnectPhoneClick" Tag="{Binding}"/>
                                            <Button Content="Rename" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                    Click="OnRenameDeviceClick" Tag="{Binding}"/>
                                            <Button Content="Remove" Style="{StaticResource FlatButton}"
                                                    Click="OnRemoveDeviceClick" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                <TextBlock DockPanel.Dock="Top" Text="Connected TVs" FontWeight="Bold" FontSize="14" Margin="0,20,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SavedTvs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                                <TextBlock Text="CONNECTED" FontSize="10" FontWeight="Bold" Margin="6,2,0,0"
                                                           Foreground="{StaticResource TealBrush}"
                                                           Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Port, StringFormat='Port {0}'}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="Disconnect" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                    Click="OnTvSectionDisconnectClick" Tag="{Binding}"
                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolVisibility}}"/>
                                            <Button Content="Rename" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                    Click="OnTvSectionRenameClick" Tag="{Binding}"/>
                                            <Button Content="Forget" Style="{StaticResource FlatButton}"
                                                    Click="OnTvSectionForgetClick" Tag="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

        <TabControl Margin="0,16,0,0" Padding="0" Visibility="{Binding IsChecked, ElementName=NavTransfers, Converter={StaticResource BoolVisibility}}">
                <TabItem Header="Sent">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource FlatButton}" Click="OnClearSentTransfersClick"/>
                            <TextBlock Text="Files sent to your phone" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SentTransfers}" ItemTemplate="{StaticResource TransferCardTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Received">
                    <DockPanel Margin="0,12,0,0">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource FlatButton}" Click="OnClearReceivedTransfersClick"/>
                            <TextBlock Text="Files received from your phone" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ReceivedTransfers}" ItemTemplate="{StaticResource TransferCardTemplate}"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>

        <DockPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavTvFiles, Converter={StaticResource BoolVisibility}}">
            <StackPanel x:Name="TvConnectPanel" DockPanel.Dock="Top">
                <TextBlock Text="Browse and download files from your TV, straight to this PC." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <TextBlock Text="TV IP ADDRESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TvHostBox" Margin="0,0,0,14"/>
                <TextBlock Text="PORT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="TvPortBox" Text="5555" Margin="0,0,0,18"/>
                <Button x:Name="TvConnectButton" Content="Connect" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnTvConnectClick"/>
                <TextBlock x:Name="TvStatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </StackPanel>

            <Grid x:Name="TvBrowserPanel" Visibility="Collapsed" AllowDrop="True"
                  DragEnter="OnTvDragEnter" DragLeave="OnTvDragLeave" Drop="OnTvDrop">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Connect new TV" Style="{StaticResource FlatButton}" Click="OnTvConnectNewClick"/>
                    <Button DockPanel.Dock="Right" Content="Upload" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnTvUploadClick"/>
                    <Button x:Name="TvViewModeButton" DockPanel.Dock="Right" Content="List view" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnTvToggleViewModeClick"/>
                    <Button x:Name="TvSortButton" DockPanel.Dock="Right" Content="Sort: Name ↑" Style="{StaticResource FlatButton}" Margin="0,0,6,0" Click="OnTvSortClick"/>
                    <TextBlock x:Name="TvUpButton" Text="←" Foreground="{StaticResource TealBrush}" FontSize="12" VerticalAlignment="Center"
                               Cursor="Hand" MouseLeftButtonUp="OnTvUpClick" Margin="0,0,8,0" ToolTip="Up one folder" Visibility="Collapsed"/>
                    <ItemsControl ItemsSource="{Binding TvBreadcrumbs}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TealBrush}" FontSize="12"
                                               Cursor="Hand" MouseLeftButtonUp="OnTvBreadcrumbClick" Tag="{Binding}"/>
                                    <TextBlock Text=" / " Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>

                <Border x:Name="TvDropOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#CC122321" CornerRadius="14"
                        BorderBrush="{StaticResource TealBrush}" BorderThickness="2" Visibility="Collapsed" Panel.ZIndex="10">
                    <TextBlock Text="Drop to upload to this folder" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TealBrush}" FontWeight="Bold" FontSize="16" IsHitTestVisible="False"/>
                </Border>

                <DockPanel x:Name="TvSelectionBar" Grid.Row="1" Margin="0,0,0,8" Visibility="Collapsed">
                    <Button DockPanel.Dock="Left" Content="✕" Style="{StaticResource FlatButton}" Padding="10,6" Click="OnTvClearSelectionClick"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Download" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="OnTvBulkDownloadClick"/>
                        <Button Content="Delete" Style="{StaticResource FlatButton}" Margin="6,0,0,0" Click="OnTvBulkDeleteClick"/>
                    </StackPanel>
                    <TextBlock x:Name="TvSelectionCountText" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </DockPanel>

                <ScrollViewer x:Name="TvListViewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl ItemsSource="{Binding TvFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Cursor="Hand" MouseLeftButtonUp="OnTvFileClick"
                                        PreviewMouseLeftButtonDown="OnTvCardPreviewMouseDown" PreviewMouseMove="OnTvCardPreviewMouseMove"
                                        MouseRightButtonUp="OnTvCardRightClick" Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="999" Margin="0,0,10,0"
                                                BorderBrush="{StaticResource MutedTextBrush}" BorderThickness="2"
                                                Background="{Binding IsSelected, Converter={StaticResource SelectedCircleBackground}}" Cursor="Hand"
                                                MouseLeftButtonUp="OnTvCheckboxClick" Tag="{Binding}"
                                                Visibility="{Binding DataContext.IsTvSelecting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                            <!-- White-on-teal, not SurfaceBrush-on-SurfaceBrush - the checkmark
                                                 used to be rendered in the same color as its own circle fill,
                                                 so it was only ever visible thanks to the border ring, and in
                                                 the grid view (semi-transparent circle over a thumbnail) it
                                                 blended into whatever was under it and looked like it wasn't
                                                 rendering on some cards at all. -->
                                            <TextBlock Text="✓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="White" FontWeight="Bold"
                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="Folder" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"
                                                       Visibility="{Binding IsDirectory, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="TvGridViewScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TvFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="140" Cursor="Hand"
                                        MouseLeftButtonUp="OnTvFileClick"
                                        PreviewMouseLeftButtonDown="OnTvCardPreviewMouseDown" PreviewMouseMove="OnTvCardPreviewMouseMove"
                                        MouseRightButtonUp="OnTvCardRightClick"
                                        Tag="{Binding}" Margin="0,0,10,10" Padding="10">
                                    <StackPanel>
                                        <Border Height="90" CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                                            <Grid>
                                                <Path Data="M10,4 L2,4 C0.9,4 0,4.9 0,6 L0,18 C0,19.1 0.9,20 2,20 L22,20 C23.1,20 24,19.1 24,18 L24,8 C24,6.9 23.1,6 22,6 L12,6 Z"
                                                      Fill="{StaticResource TealBrush}" Stretch="Uniform" Width="40" Height="40"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsDirectory, Converter={StaticResource BoolVisibility}}"/>
                                                <TextBlock Text="🎬" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsVideo, Converter={StaticResource BoolVisibility}}"/>
                                                <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding IsOther, Converter={StaticResource BoolVisibility}}"/>
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource ImagePathToBitmap}}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}"/>
                                                <Border Width="22" Height="22" CornerRadius="999" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                                                        BorderBrush="White" BorderThickness="2"
                                                        Background="{Binding IsSelected, Converter={StaticResource SelectedCircleBackground}}" Cursor="Hand"
                                                        MouseLeftButtonUp="OnTvCheckboxClick" Tag="{Binding}"
                                                        Visibility="{Binding DataContext.IsTvSelecting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}">
                                                    <!-- Solid teal fill once selected instead of a fixed 35%-alpha
                                                         black wash - previously the checkmark (drawn in the same
                                                         dark SurfaceBrush color) sat over whatever thumbnail color
                                                         showed through, so it read as "missing" on darker photos
                                                         and only showed up by accident on lighter ones. -->
                                                    <TextBlock Text="✓" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="White" FontWeight="Bold"
                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <DockPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavScreenView, Converter={StaticResource BoolVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="Screen View" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="Mirror a TV or phone's screen on this PC, same as the old scrcpy shortcut - opens in its own window."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ScreenViewError}" Foreground="#FF6B5E" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding HasScreenViewError, Converter={StaticResource BoolVisibility}}"/>
            <TabControl Padding="0">
                <TabItem Header="TV">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding SavedTvs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                                <TextBlock Text="{Binding Port, StringFormat='Port {0}'}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Rename" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                        Click="OnTvSectionRenameClick" Tag="{Binding}"/>
                                                <Button Content="View screen" Style="{StaticResource FlatButton}"
                                                        Click="OnScreenViewClick" Tag="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Phone">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Top" Content="Refresh" Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Right" Margin="0,0,0,12" Click="OnRefreshPhoneScreenDevicesClick"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding PhoneScreenDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Rename" Style="{StaticResource FlatButton}" Margin="0,0,6,0"
                                                            Click="OnRenamePhoneScreenDeviceClick" Tag="{Binding}"/>
                                                    <Button Content="View screen" Style="{StaticResource FlatButton}"
                                                            Click="OnPhoneScreenViewClick" Tag="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <DockPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavRemote, Converter={StaticResource BoolVisibility}}">
            <TextBlock DockPanel.Dock="Top" Text="Remote" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Text="Control the connected TV the same way the phone app's Remote tab does - plain ADB keyevents, no TV companion app needed."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsTvConnectedForInstall, Converter={StaticResource InverseBoolVisibility}}">
                <TextBlock Text="Connect to a TV first (Devices or TV Files tab), then come back here." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="{Binding RemoteActionError}" Foreground="#FF6B5E" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding HasRemoteActionError, Converter={StaticResource BoolVisibility}}"/>

            <TabControl Padding="0" Visibility="{Binding IsTvConnectedForInstall, Converter={StaticResource BoolVisibility}}">
                <TabItem Header="D-pad">
                    <!-- Two columns side by side, the whole block centered as
                         one unit in the tab's available width - previously
                         every piece (touchpad, pills, button cluster) was its
                         own separately-centered row stacked tall and narrow,
                         which left the window's actual width unused and
                         forced vertical scrolling. Column heights are tuned
                         to land close to equal (touchpad ~250px vs. the
                         button cluster's D-pad-plus-media-row ~240px) so
                         neither column visually dwarfs the other. -->
                    <Grid HorizontalAlignment="Center" Margin="0,24,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,32,0">
                            <!-- Touchpad: only usable once TV Bridge Cursor is
                                 installed + enabled on the TV (checked when
                                 this tab is opened) - same prerequisite the
                                 phone app's cursor mode has. Not installed
                                 shows a pointer to the phone app's Install
                                 screen instead of a confusing connection
                                 failure on first drag. -->
                            <TextBlock Text="Move your mouse over this area to move the cursor, click to tap." Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                                       Width="360" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding IsCursorReady, Converter={StaticResource BoolVisibility}}"/>
                            <Border Style="{StaticResource CardBorder}" Width="360" Height="230" Margin="0,0,0,16"
                                    Cursor="Hand" Background="{StaticResource SurfaceBrush}"
                                    Visibility="{Binding IsCursorReady, Converter={StaticResource BoolVisibility}}"
                                    PreviewMouseLeftButtonDown="OnTouchpadMouseDown" MouseMove="OnTouchpadMouseMove">
                                <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="{StaticResource MutedTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="360" Height="230" Margin="0,0,0,16"
                                    Visibility="{Binding IsCursorNotReady, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Cursor mode needs TV Bridge Cursor installed on the TV - install it from the phone app's Install screen, then reopen this tab."
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Border>

                            <!-- Recent/Back pills directly under the touchpad,
                                 same relative position the phone's touchpad-
                                 adjacent row occupies. -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource FlatButton}" Margin="0,0,10,0" Click="OnRemoteInputClick" ToolTip="Opens the TV's input-switch overlay">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Recent" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource FlatButton}" Click="OnRemoteBackClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Back" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Home/Power/Settings on the left of the D-pad,
                                 Volume on the right - same side-column layout
                                 as the phone app's CompactDPadBlock. Column
                                 heights match the D-pad's own height (three
                                 36px buttons + two 14px gaps = 136px, same as
                                 the 136px D-pad) so all three sit level with
                                 it instead of looking taller/shorter by eye. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,0,14" Click="OnRemoteHomeClick" ToolTip="Home">
                                        <TextBlock Text="&#xE10F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,0,14" Click="OnRemotePowerClick" ToolTip="Power">
                                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Click="OnRemoteTvSettingsClick" ToolTip="TV Settings">
                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                </StackPanel>

                                <!-- Round D-pad: one big circle for the ring,
                                     arrow glyphs floating on it (no separate
                                     button backgrounds per arrow), OK as a
                                     smaller filled teal circle in the center -
                                     same layered-circle shape as the phone
                                     app's DPad composable. -->
                                <Grid Grid.Column="1" Width="136" Height="136">
                                    <Ellipse Fill="{StaticResource CardBrush}"/>
                                    <Button Style="{StaticResource CircleButton}" Background="Transparent" Width="38" Height="38"
                                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0" Click="OnRemoteDpadUpClick">
                                        <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Background="Transparent" Width="38" Height="38"
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" Click="OnRemoteDpadDownClick">
                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Background="Transparent" Width="38" Height="38"
                                            VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0" Click="OnRemoteDpadLeftClick">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Background="Transparent" Width="38" Height="38"
                                            VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" Click="OnRemoteDpadRightClick">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleAccentButton}" Content="OK" Width="46" Height="46"
                                            VerticalAlignment="Center" HorizontalAlignment="Center" Click="OnRemoteDpadCenterClick"/>
                                </Grid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,0,14" Click="OnRemoteVolumeDownClick" ToolTip="Volume down">
                                        <TextBlock Text="&#xE949;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,0,14" Click="OnRemoteMuteClick" ToolTip="Mute">
                                        <TextBlock Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                    <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Click="OnRemoteVolumeUpClick" ToolTip="Volume up">
                                        <TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,12,0" Click="OnRemoteRewindClick" ToolTip="Rewind">
                                    <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="0,0,12,0" Click="OnRemotePlayPauseClick" ToolTip="Play/Pause">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                </Button>
                                <Button Style="{StaticResource CircleButton}" Width="36" Height="36" Click="OnRemoteFastForwardClick" ToolTip="Fast forward">
                                    <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="15"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Apps">
                    <DockPanel Margin="0,12,0,0">
                        <Button DockPanel.Dock="Top" Content="Refresh" Style="{StaticResource FlatButton}"
                                HorizontalAlignment="Right" Margin="0,0,0,12" Click="OnRefreshRemoteAppsClick"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RemoteApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardBorder}" Cursor="Hand" MouseLeftButtonUp="OnRemoteAppClick" Tag="{Binding}">
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="{StaticResource AmberBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
                <TextBlock Text="DEVICE NAME" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="DeviceNameBox" Margin="0,0,0,18"/>

                <TextBlock Text="PORT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="PortBox" Margin="0,0,0,18"/>

                <TextBlock Text="MAX HISTORY ITEMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="MaxHistoryBox" Margin="0,0,0,18"/>

                <CheckBox x:Name="LaunchAtStartupCheck" Content="Launch at Windows startup" Margin="0,0,0,18"/>

                <TextBlock Text="AUTO-SEND TO PRIMARY PHONE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoSendImagesCheck" Content="Copy images to phone clipboard" Margin="0,0,0,8"/>
                <CheckBox x:Name="SendImagesAsFileCheck" Content="Send images to phone as files" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoSendTextCheck" Content="Text" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoSendFilesCheck" Content="Files" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoSendFoldersCheck" Content="Folders" Margin="0,0,0,4"/>
                <TextBlock Text="All off by default - copying something sensitive (a password, etc.) won't be sent unless the matching toggle is on. Turn one on only while you actually want that live sync. If both image options are on, &quot;Send as files&quot; takes over for that copy."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <TextBlock Text="RECEIVE FILES FROM PHONE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ReceiveFilesCheck" Content="Accept files sent via Copy to PC" Margin="0,0,0,8" Checked="OnReceiveFilesCheckChanged" Unchecked="OnReceiveFilesCheckChanged"/>
                <StackPanel x:Name="ReceiveFilesFolderPanel" Margin="0,0,0,8">
                    <TextBlock Text="SAVE LOCATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ReceivedFilesFolderBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource FlatButton}" Click="OnBrowseReceivedFilesFolderClick"/>
                    </Grid>
                </StackPanel>
                <TextBlock Text="If no location is chosen, files are saved to Downloads\TV File Bridge."
                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,20"/>

                <Button Content="Save settings" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnSaveSettingsClick" Margin="0,0,0,16"/>
            </StackPanel>
            </ScrollViewer>

        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsChecked, ElementName=NavInstallApk, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="Install APK" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <TextBlock Text="Sideload an APK straight onto the connected TV, same as running adb install - no need to copy the file onto the TV first."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Visibility="{Binding IsTvConnectedForInstall, Converter={StaticResource InverseBoolVisibility}}">
                <TextBlock Text="Connect to a TV first (Devices or TV Files tab), then come back here." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsTvConnectedForInstall, Converter={StaticResource BoolVisibility}}">
                <Button x:Name="PickApkButton" Content="Choose APK…" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Click="OnPickApkClick"/>

                <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Visibility="{Binding HasApkInstallStatus, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ApkInstallFileName}" FontWeight="Bold"/>
                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ApkInstallProgress, Mode=OneWay}"
                                     Foreground="{StaticResource TealBrush}" Background="{StaticResource SurfaceBrush}" BorderThickness="0"
                                     Margin="0,8,0,8" Visibility="{Binding IsApkInstalling, Converter={StaticResource BoolVisibility}}"/>
                        <TextBlock Text="{Binding ApkInstallStatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
        </Grid>
        </DockPanel>
    </Grid>
</Window>
