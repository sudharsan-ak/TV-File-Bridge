<Window x:Class="PcCompanion.ReconnectTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reconnect TV" Height="260" Width="360"
        Background="#122321"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="16" Background="#122321" BorderBrush="#22403B" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Reconnect TV" FontSize="16" FontWeight="Bold" Foreground="#EEF7F4" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" Text="If the TV's IP address changed, enter the new one here." FontSize="11" Foreground="#8FB3AC" TextWrapping="Wrap" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="2" Text="IP address" FontSize="11" Foreground="#8FB3AC" Margin="0,0,0,4"/>
            <TextBox x:Name="HostBox" Grid.Row="3" Background="#16302C" Foreground="#EEF7F4" BorderBrush="#22403B"
                     BorderThickness="1" Padding="10,7" CaretBrush="#37C6B0" Margin="0,0,0,12"/>

            <TextBlock x:Name="ErrorText" Grid.Row="4" Foreground="#FF6B5E" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#16302C"/>
                            <Setter Property="Foreground" Value="#EEF7F4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22403B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="ConnectButton" Content="Connect" Width="90" IsDefault="True" Click="OnConnectClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#37C6B0"/>
                            <Setter Property="Foreground" Value="#0B1615"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
