<Window x:Class="PcCompanion.AddTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add TV" Height="480" Width="380"
        Background="#122321"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Border CornerRadius="16" Background="#122321" BorderBrush="#22403B" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Add TV" FontSize="16" FontWeight="Bold" Foreground="#EEF7F4" Margin="0,0,0,12"/>

            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Nearby devices" FontSize="11" Foreground="#8FB3AC" VerticalAlignment="Center"/>
                <Button x:Name="RescanButton" Grid.Column="1" Content="Rescan" Click="OnRescanClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#37C6B0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <TextBlock x:Name="ScanStatusText" Grid.Row="2" Text="Scanning your network for devices with ADB open…"
                       FontSize="11" Foreground="#8FB3AC" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#16302C" CornerRadius="10" Margin="0,0,0,6" Padding="10,8" Cursor="Hand"
                                    MouseLeftButtonUp="OnResultClick" Tag="{Binding}">
                                <TextBlock Text="{Binding Host}" Foreground="#EEF7F4" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="4" Text="Name" FontSize="11" Foreground="#8FB3AC" Margin="0,12,0,4"/>
            <TextBox x:Name="NameBox" Grid.Row="5" Background="#16302C" Foreground="#EEF7F4" BorderBrush="#22403B"
                     BorderThickness="1" Padding="10,7" CaretBrush="#37C6B0" Margin="0,0,0,10"/>

            <Grid Grid.Row="6" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TV IP address" FontSize="11" Foreground="#8FB3AC" Margin="0,0,0,4"/>
                    <TextBox x:Name="HostBox" Grid.Row="1" Background="#16302C" Foreground="#EEF7F4" BorderBrush="#22403B"
                             BorderThickness="1" Padding="10,7" CaretBrush="#37C6B0"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Port" FontSize="11" Foreground="#8FB3AC" Margin="0,0,0,4"/>
                    <TextBox x:Name="PortBox" Grid.Row="1" Text="5555" Background="#16302C" Foreground="#EEF7F4" BorderBrush="#22403B"
                             BorderThickness="1" Padding="10,7" CaretBrush="#37C6B0"/>
                </Grid>
            </Grid>

            <TextBlock x:Name="ErrorText" Grid.Row="7" Foreground="#FF6B5E" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Width="90" Margin="0,0,8,0" Click="OnCancelClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#16302C"/>
                            <Setter Property="Foreground" Value="#EEF7F4"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22403B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="AddButton" Content="Add" Width="90" IsDefault="True" Click="OnAddClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#37C6B0"/>
                            <Setter Property="Foreground" Value="#0B1615"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="14,7">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
